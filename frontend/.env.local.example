# ── Mapbox (exposed to browser — must start with NEXT_PUBLIC_) ────────────────
# Used by the map component on the frontend. Same key as your backend.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.YOUR_MAPBOX_TOKEN_HERE

# Optional: flight path display (map only; does not change API geometry)
# Great-circle densify (default on) — arcs each leg so 2-point paths aren’t screen-straight; then Chaikin + spline
# NEXT_PUBLIC_FLIGHT_PATH_GREAT_CIRCLE=1
# NEXT_PUBLIC_FLIGHT_PATH_GC_MIN_STEPS=8
# NEXT_PUBLIC_FLIGHT_PATH_GC_MAX_STEPS=24
# NEXT_PUBLIC_FLIGHT_PATH_GC_MAX_VERTICES=380
# NEXT_PUBLIC_FLIGHT_PATH_CHAIKIN_PASSES=2
# NEXT_PUBLIC_FLIGHT_PATH_SPLINE_SEGMENTS=14
# NEXT_PUBLIC_FLIGHT_PATH_SPLINE_ALPHA=0.5
# Set spline segments to 0 for polyline-only (still great-circle arcs if enabled)

# ── Backend API URL ───────────────────────────────────────────────────────────
# Points to your Python FastAPI server
# Local development: http://localhost:8000
# Production: https://your-backend.railway.app
BACKEND_URL=http://localhost:8000

# ── Supabase Auth (identity for Saved Reports later; scans stay public) ───────
# Project Settings → API: Project URL + anon public key (NOT the service_role key)
# Enable Email + Google under Authentication → Providers
# Keep Confirm email ON for production (do not disable as a workaround).
#
# Redirect URLs (Authentication → URL Configuration):
#   http://localhost:3000/auth/callback
#   https://dwellsense.vercel.app/auth/callback
# Site URL: https://dwellsense.vercel.app
#
# Production email (required): connect custom SMTP — Supabase built-in mail is
# not production-grade and often fails to deliver to real users.
# Recommended: Resend → verify a sending domain → Supabase Auth → SMTP:
#   Host smtp.resend.com | Port 465 | User resend | Pass <Resend API key>
#   Sender: e.g. noreply@YOUR_DOMAIN
# Then raise Auth rate limits above the default 30/hour if needed.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
