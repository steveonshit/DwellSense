# ── Mapbox ────────────────────────────────────────────────────────────────────
# Used for geocoding (address → lat/lng). Get yours at mapbox.com
MAPBOX_TOKEN=pk.YOUR_MAPBOX_TOKEN_HERE

# ── Google Maps Platform ───────────────────────────────────────────────────────
# Needs: Places API (New), Distance Matrix API, Geocoding API
# Get yours at console.cloud.google.com
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Real key from aistudio.google.com (not the placeholder). Whitespace is stripped.
# Card titles/scores are computed in Python; Gemini only writes threat-card bullets.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Optional: model name. Default is gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash
# Optional: seconds for Gemini request (default 300). Set to 0 to disable asyncio timeout guard.
# GEMINI_TIMEOUT_SECONDS=300
# Optional: max output tokens for Gemini JSON (default 2048)
# GEMINI_MAX_OUTPUT_TOKENS=2048

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL and service role key (NOT the anon key)
# Get yours at supabase.com → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# ── OpenSky Network (optional) ────────────────────────────────────────────────
# Free account at opensky-network.org — increases rate limits
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# ── Flights ───────────────────────────────────────────────────────────────────
# How to determine nearby flight corridors on the map:
# - static (default): use simplified, hand-authored NYC corridor lines
# - adsb: live track polylines from OpenSky ADS-B near the property
FLIGHT_MODE=static

# ── ADS-B sample ingest (optional — fills public.adsb_samples for flight_exposure) ─
# 1) Run backend/sql/adsb_samples.sql in Supabase SQL editor once.
# 2) Set ADSB_INGEST_ENABLED=true on Railway so the API process ingests on a timer.
# ADSB_INGEST_ENABLED=false
# Seconds between ingest runs when enabled (main.py default 3600 = 1 hour; min 60).
# ADSB_INGEST_INTERVAL_SECONDS=3600

# ── App Config ────────────────────────────────────────────────────────────────
PORT=8000
FRONTEND_URL=http://localhost:3000
