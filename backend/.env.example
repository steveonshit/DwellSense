# ── Mapbox ────────────────────────────────────────────────────────────────────
# Used for geocoding (address → lat/lng). Get yours at mapbox.com
MAPBOX_TOKEN=pk.YOUR_MAPBOX_TOKEN_HERE

# ── Google Maps Platform ───────────────────────────────────────────────────────
# Needs: Places API (New), Distance Matrix API, Geocoding API
# Get yours at console.cloud.google.com
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Real key from aistudio.google.com (not the placeholder). Whitespace is stripped.
# Card titles/scores are computed in Python; Gemini only writes threat-card bullets.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Optional: model name. Default is gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash
# Optional: seconds for Gemini request (default 300). Set to 0 to disable asyncio timeout guard.
# GEMINI_TIMEOUT_SECONDS=300
# Optional: max output tokens for Gemini JSON (default 2048)
# GEMINI_MAX_OUTPUT_TOKENS=2048

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL and service role key (NOT the anon key)
# Get yours at supabase.com → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# ── OpenSky Network (optional) ────────────────────────────────────────────────
# Free account at opensky-network.org — increases rate limits
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# ── Flights ───────────────────────────────────────────────────────────────────
# Map flight geometry (see services/flights.py):
# - auto (default): polylines from Supabase public.adsb_samples when ingest has data;
#   otherwise simplified NYC corridor segments. No OpenSky calls during /scan.
# - static: corridor segments only.
# - live_adsb: capped OpenSky states + a few sequential track fetches (optional; can be slow).
# Legacy: FLIGHT_MODE=adsb is treated the same as auto (stored samples first).
FLIGHT_MODE=auto
# Optional tuning when FLIGHT_MODE=auto (stored-sample polylines)
# ADSB_PATH_DAYS=7
# ADSB_PATH_BBOX_MILES=22
# ADSB_PATH_MIN_POINTS=2
# ADSB_PATH_MAX_POINTS=40
# ADSB_PATH_ROW_LIMIT=15000
# Smaller = smoother polyline (miles between inserted vertices along each segment; 0 = off). No extra HTTP.
# ADSB_PATH_DENSIFY_STEP_MILES=0.28
# Optional tuning for live_adsb only
# OPENSKY_MAX_TRACK_FETCHES=3
# OPENSKY_TRACK_TIMEOUT_SECONDS=5
# OPENSKY_SCAN_BUDGET_SECONDS=18

# Flight exposure (/scan flight_exposure) uses the same adsb_samples table.
# EXPOSURE_DAYS=7
# EXPOSURE_RADIUS_MILES=1.5

# ── ADS-B sample ingest (optional — fills public.adsb_samples for flight_exposure) ─
# 1) Run backend/sql/adsb_samples.sql in Supabase SQL editor once.
# 2) Set ADSB_INGEST_ENABLED=true on Railway so the API process ingests on a timer.
# ADSB_INGEST_ENABLED=false
# Seconds between ingest runs when enabled (main.py default 3600 = 1 hour; min 60).
# ADSB_INGEST_INTERVAL_SECONDS=3600
# Optional: OpenSky HTTP timeout for ingest only (seconds, default 25).
# ADSB_OPENSKY_TIMEOUT_SECONDS=25

# ── App Config ────────────────────────────────────────────────────────────────
PORT=8000
FRONTEND_URL=http://localhost:3000
